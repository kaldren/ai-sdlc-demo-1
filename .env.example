# Copy to .env (git-ignored) and fill in. Never commit real keys.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Optional: LangSmith tracing while learning LangChain
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# API settings (prefix LEYA_)
LEYA_ENVIRONMENT=local
# Local Postgres password: `make env` generates a random value here. Never reuse it elsewhere.
LEYA_DB_PASSWORD=
# For running the API outside docker, set:
# LEYA_DATABASE_URL=postgresql+psycopg://leya:<LEYA_DB_PASSWORD>@localhost:5432/leya
